# Development: keep these two EMPTY so requests go through the Vite proxy (/api, /ws).
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Where the Vite dev/preview proxy forwards to. Change this if your environment gives you another API URL
# (e.g. a local mock: http://localhost:8000).
VITE_PROXY_TARGET=https://ts.idicorp.ir
